      <item row="1" column="1"><widget class="QSlider" name="slider_h_max"><property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property><property name="maximum"><number>179</number></property><property name="value"><number>179</number></property></widget></item>
      <!-- S Min -->
      <item row="2" column="0"><widget class="QLabel" name="label_s_min"><property name="text"><string>S Min: 0</string></property></widget></item>
      <item row="2" column="1"><widget class="QSlider" name="slider_s_min"><property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property><property name="maximum"><number>255</number></property></widget></item>
      <!-- S Max -->
      <item row="3" column="0"><widget class="QLabel" name="label_s_max"><property name="text"><string>S Max: 255</string></property></widget></item>
      <item row="3" column="1"><widget class="QSlider" name="slider_s_max"><property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property><property name="maximum"><number>255</number></property><property name="value"><number>255</number></property></widget></item>
      <!-- V Min -->
      <item row="4" column="0"><widget class="QLabel" name="label_v_min"><property name="text"><string>V Min: 0</string></property></widget></item>
      <item row="4" column="1"><widget class="QSlider" name="slider_v_min"><property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property><property name="maximum"><number>255</number></property></widget></item>
      <!-- V Max -->
