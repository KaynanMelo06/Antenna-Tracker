      <item row="5" column="1"><widget class="QSlider" name="slider_v_max"><property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property><property name="maximum"><number>255</number></property><property name="value"><number>255</number></property></widget></item>
      <!-- Botões -->
