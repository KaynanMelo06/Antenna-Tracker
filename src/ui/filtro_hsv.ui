<ui version="4.0">
 <class>HSVFilterWindow</class>
 <widget class="QMainWindow" name="HSVFilterWindow">
  <property name="windowTitle">
   <string>Calibração HSV — Múltiplos Filtros</string>
  </property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QVBoxLayout" name="verticalLayout">
    <item>
