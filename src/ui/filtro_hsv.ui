      <property name="text"><string>[Imagem Aqui]</string></property>
      <property name="alignment">
       <set>Qt::AlignmentFlag::AlignCenter</set>
      </property>
     </widget>
    </item>
    <item>
     <layout class="QGridLayout" name="gridLayout">
      <!-- H Min -->
      <item row="0" column="0"><widget class="QLabel" name="label_h_min"><property name="text"><string>H Min: 0</string></property></widget></item>
      <item row="0" column="1"><widget class="QSlider" name="slider_h_min"><property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property><property name="maximum"><number>179</number></property></widget></item>
      <!-- H Max -->
